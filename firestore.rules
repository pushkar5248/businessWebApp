
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check ownership
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Rules for the 'users' collection
    match /users/{userId} {
      // Users can read and write their own settings document
      allow read, write: if isOwner(userId);
    }
    
    // Rules for the 'inventory' collection
    match /inventory/{itemId} {
      // Allow full access if the user is the owner
      allow read, write, delete: if isOwner(resource.data.userId);
      // Allow creation if the new document's userId matches the user's uid
      allow create: if isOwner(request.resource.data.userId);
    }

    // Rules for the 'sales' collection
    match /sales/{saleId} {
      // Allow full access if the user is the owner
      allow read, write, delete: if isOwner(resource.data.userId);
      // Allow creation if the new document's userId matches the user's uid
      allow create: if isOwner(request.resource.data.userId);
    }

    // Rules for the 'purchases' collection
    match /purchases/{purchaseId} {
       // Allow full access if the user is the owner
      allow read, write, delete: if isOwner(resource.data.userId);
      // Allow creation if the new document's userId matches the user's uid
      allow create: if isOwner(request.resource.data.userId);
    }
  }
}
