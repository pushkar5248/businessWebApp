rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the user is the owner of a document
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Rules for the 'users' collection
    match /users/{userId} {
      // Users can read and update their own profile document
      allow read, update: if isOwner(userId);
    }

    // Rules for the 'inventory' collection
    match /inventory/{itemId} {
      // Users can do anything to an inventory item document if they own it
      allow read, write, delete: if isOwner(resource.data.userId);
      // Users can create new inventory items
      allow create: if isOwner(request.resource.data.userId);
    }

    // Rules for the 'sales' collection
    match /sales/{saleId} {
      // Users can do anything to a sale document if they own it
      allow read, write, delete: if isOwner(resource.data.userId);
      // Users can create new sales
      allow create: if isOwner(request.resource.data.userId);
    }

    // Rules for the 'purchases' collection
    match /purchases/{purchaseId} {
      // Users can do anything to a purchase document if they own it
      allow read, write, delete: if isOwner(resource.data.userId);
      // Users can create new purchases
      allow create: if isOwner(request.resource.data.userId);
    }
  }
}
