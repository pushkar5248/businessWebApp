rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can only read and write to their own user settings document.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Inventory, sales, and purchases can only be accessed by the user who created them.
    match /inventory/{documentId} {
      allow read, write, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    match /sales/{documentId} {
      allow read, write, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    
    match /purchases/{documentId} {
      allow read, write, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // The GSTIN data is public and can be read by any authenticated user.
    // Writing is disabled from the client-side for security.
    match /gstin_data/{gstin} {
      allow read: if request.auth != null;
      allow write: if false; 
    }
  }
}
