rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check ownership
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    
    // Rules for the 'users' collection
    match /users/{userId} {
      // Users can read and update their own profile document
      allow read, update: if isOwner(userId);
      // Users can create their own profile document, but not for others
      allow create: if isOwner(userId);
    }

    // Rules for collections with user-owned data
    match /{collection}/{docId} {
      // Allow full access if the document's userId matches the requestor's UID
      allow read, write, delete: if isOwner(get(/databases/$(database)/documents/$(collection)/$(docId)).data.userId);
       // Allow create if the new document's userId matches the requestor's UID
      allow create: if isOwner(request.resource.data.userId);
    }
  }
}

    