
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
  
    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Allow users to read/write their own documents in any collection
    match /{collection}/{userId} {
      allow read, write, update, delete: if request.auth != null && request.auth.uid == userId;
    }

    // Allow logged-in users to manage their data in subcollections
    match /{collection}/{userId}/{subcollection}/{docId} {
        allow read, write, update, delete: if request.auth != null && request.auth.uid == userId;
    }
    
    // Allow any authenticated user to read from the public gstin_data collection
    match /gstin_data/{gstin} {
      allow get, list: if request.auth != null;
    }
  }
}
