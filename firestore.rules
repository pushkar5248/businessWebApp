rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // Helper function to check ownership
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Users can only read/write their own user document
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Rules for inventory collection
    match /inventory/{itemId} {
      allow read: if isOwner(get(/databases/$(database)/documents/inventory/$(itemId)).data.userId);
      allow create: if isOwner(request.resource.data.userId);
      allow update, delete: if isOwner(get(/databases/$(database)/documents/inventory/$(itemId)).data.userId);
    }
    
    // Rules for sales collection
    match /sales/{saleId} {
       allow read: if isOwner(get(/databases/$(database)/documents/sales/$(saleId)).data.userId);
       allow create: if isOwner(request.resource.data.userId);
       allow update, delete: if isOwner(get(/databases/$(database)/documents/sales/$(saleId)).data.userId);
    }
    
    // Rules for purchases collection
    match /purchases/{purchaseId} {
       allow read: if isOwner(get(/databases/$(database)/documents/purchases/$(purchaseId)).data.userId);
       allow create: if isOwner(request.resource.data.userId);
       allow update, delete: if isOwner(get(/databases/$(database)/documents/purchases/$(purchaseId)).data.userId);
    }
  }
}